rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Subscriptions: tied to Google account (Firebase UID)
    // Users can read their own subscription status
    // All writes are server-side only (via Firebase Admin SDK)
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Users: profile + subscription data linked to Google account
    // Users can read their own profile
    // All writes are server-side only
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      // Payment history sub-collection
      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Payment orders: server-side only, no client access
    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }

    // Subscription devices: server-side only
    match /subscriptionDevices/{deviceId} {
      allow read, write: if false;
    }

    // Referral system
    match /referrals/{referralId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Device registry for referral anti-cheat
    match /devices/{deviceId} {
      allow read, write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
