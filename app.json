{
  "expo": {
    "name": "StatusVault",
    "slug": "statusvault",
    "version": "1.3.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "statusvault",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#05070A"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.binan.statussaver"
    },
    "android": {
      "package": "com.binan.statussaver",
      "versionCode": 40,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "blockedPermissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 24,
            "abiFilters": [
              "arm64-v8a",
              "armeabi-v7a",
              "x86_64"
            ]
          }
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "position": "relative",
          "backgroundColor": "#05070A",
          "buttonStyle": "light"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow StatusVault to save photos to your gallery",
          "savePhotosPermission": "Allow StatusVault to save photos and videos",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "./plugins/with-max-compat.js",
      "./plugins/with-saf-picker.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
