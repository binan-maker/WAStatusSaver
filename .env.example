# Copy this file to .env for local configuration.
# Never commit .env or private service credentials.

# Build mode used by app.config.js. Set to production for a release build.
EXPO_PUBLIC_BUILD_ENV=development

# Google AdMob app IDs. These are public identifiers, but they must be real
# production IDs. Google test app IDs are intentionally rejected.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# Google AdMob unit IDs. Create one real unit for each format you use.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADMOB_NATIVE_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY

# RevenueCat public SDK keys. These are safe to ship in the mobile bundle.
# Use the Android/iOS production keys from the corresponding RevenueCat app.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_REPLACE_WITH_ANDROID_PUBLIC_KEY
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=whatsapp_status_saver_pro
EXPO_PUBLIC_REVENUECAT_LIFETIME_PRODUCT_ID=premium_lifetime

# Server-side values are intentionally listed by name only. Store their real
# values in Replit Secrets/environment variables, never in this file.
# REVENUECAT_PROJECT_ID=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# GOOGLE_PLAY_PACKAGE_NAME=com.binan.statussaver
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_PROJECT_ID=